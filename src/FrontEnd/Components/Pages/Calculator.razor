                                            <RadzenGridLines Visible="true" Stroke="#d0d9e0" StrokeWidth="1" />
                                        </RadzenValueAxis>
                                    </RadzenChart>
                                </div>
                                <div class="col-12 col-xl-6">
                                    <p class="chart-title" style="color:#bf360c">
                                        ● EDEPM<sub>H</sub> over Distance (p=@_exponentP, T=@_exposureTimeHours h)
