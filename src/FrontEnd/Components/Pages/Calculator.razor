        }

    </div><!-- /results-col -->

    <div class="col-12 col-xl-4 order-2 calc-sidebar">

        <!-- GEOMETRY PREVIEW -->
        <div class="section-card mb-4">
            <div class="section-header">
                <span class="sidebar-header-label">Geometry Preview</span>
                <span class="ms-auto text-muted" style="font-size:0.75rem">cross-section view</span>
