    </div>

</div>

@code {
    
    /// <summary>Flat UI representation of one conductor / bundle.</summary>
    private class ConductorModel
    {
        public string     Id           { get; set; } = "?";
        public double     X            { get; set; }
        public double     Y            { get; set; } = 12;

        // Bundle geometry
        public BundleType Bundle       { get; set; } = BundleType.Single;
        public double     SubRadius    { get; set; } = 0.015;  // r_s – sub-conductor radius [m]
        public double     Spacing      { get; set; } = 0.4;    // s   – spacing between adjacent sub-conductors [m]

        // Electrical state
        public double     VoltageRms   { get; set; }
        public double     VoltageAngle { get; set; }
        public double     CurrentRms   { get; set; }
        public double     CurrentAngle { get; set; }
        public bool       IncludeE     { get; set; } = true;
        public bool       IncludeB     { get; set; } = true;

        /// <summary>Equivalent bundle radius r_eq computed from bundle parameters (read-only display).</summary>
        public double EquivalentRadius =>
            BundleCalculator.CalculateEquivalentRadius(Bundle, SubRadius,
                Bundle == BundleType.Single ? 0 : Spacing);
    }

    private enum ObsMode    { SinglePoint, Profile }
    private enum ResultView { Charts, Table }
    
    private List<ConductorModel> _conductors = new();

    private ObsMode _mode      = ObsMode.Profile;
    private double  _ptX;
    private double  _ptY       = 1;
    private double  _profY     = 1;
    private double  _profXMin  = -50;
    private double  _profXMax  =  50;
    private int     _profSteps = 101;

    // Exposure settings
    private double _exposureTimeHours = 8.0;   // default: 8-hour working day
    private double _exponentP         = 2.0;   // p=2 → energetic interpretation

    private IReadOnlyList<FieldResult>?    _fieldResults;
    private IReadOnlyList<ExposureResult>? _exposureData;   // results from backend CalculateExposure
    private string?                        _errorMessage;

    private ResultView _fieldResultView    = ResultView.Charts;
    private ResultView _exposureResultView = ResultView.Charts;
    
    private static readonly string[] ConductorPalette =
        { "#1565C0", "#E65100", "#B71C1C", "#2E7D32", "#6A1B9A", "#00695C" };

    private const double ElectricTolerance  = 1e-6;
    private const double MagneticBTolerance = 1e-12;
    private const double MagneticHTolerance = 1e-6;

    private static string GetConductorColor(int index)
        => ConductorPalette[index % ConductorPalette.Length];

    private string? FieldConsistencyWarningMessage
    {
        get
        {
            if (_fieldResults is null || _fieldResults.Count == 0)
                return null;

            double maxEDifference = _fieldResults.Max(r => r.EDifference);
            double maxBDifference = _fieldResults.Max(r => r.BDifference);
            double maxHDifference = _fieldResults.Max(r => r.HDifference);

            var warnings = new List<string>();

            if (maxEDifference > ElectricTolerance)
                warnings.Add($"max |ΔE| = {maxEDifference:G4} V/m (tol {ElectricTolerance:G4} V/m)");

            if (maxBDifference > MagneticBTolerance)
                warnings.Add($"max |ΔB| = {(maxBDifference * 1e6):G4} µT (tol {(MagneticBTolerance * 1e6):G4} µT)");

            if (maxHDifference > MagneticHTolerance)
                warnings.Add($"max |ΔH| = {maxHDifference:G4} A/m (tol {MagneticHTolerance:G4} A/m)");

            return warnings.Count == 0
                ? null
                : $"Reconstructed values from ellipse semi-axes differ from the main totals beyond tolerance: {string.Join("; ", warnings)}. The total E, B, H values and exposure calculations remain unchanged.";
        }
    }
    
    private record GeometryPoint(double GX, double GY);

    private List<GeometryPoint> ObsLevelLineData
    {
        get
        {
            double obsY = _mode == ObsMode.Profile ? _profY : _ptY;
            double xMin = _conductors.Any() ? _conductors.Min(c => c.X) - 4 : -10;
            double xMax = _conductors.Any() ? _conductors.Max(c => c.X) + 4 : 10;
            return new() { new(xMin, obsY), new(xMax, obsY) };
        }
    }
    
    private double PeakE => _fieldResults?.Max(r => r.E)       ?? 0;
    private double PeakB => _fieldResults?.Max(r => r.B * 1e6) ?? 0;
    private double PeakH => _fieldResults?.Max(r => r.H)       ?? 0;

    // ── Chart Y-axis bounds: 10 % headroom above peak, baseline at 0 ─────────
    private double? EChartMax       => _fieldProfileData is null ? null
        : _fieldProfileData.Max(p => new[] { p.E, p.Ea, p.EFromAxes }.Max()) * 1.10;
    private double? HChartMax       => _fieldProfileData is null ? null
        : _fieldProfileData.Max(p => new[] { p.H, p.Ha, p.HFromAxes }.Max()) * 1.10;
    private double? EdepePlotMax    => _edepePlotData    is null ? null
        : _edepePlotData.Max(p => p.Y)    * 1.10;
    private double? MedepmHPlotMax  => _medepmHPlotData  is null ? null
        : _medepmHPlotData.Max(p => p.Y)  * 1.10;
    
    protected override void OnInitialized() => LoadDefaultConductors();
    
    private void LoadDefaultConductors()
    {
        double vRms = 110_000.0 / Math.Sqrt(3); 
        _conductors =
        [
            new() { Id = "A", X = -4, Y = 12, Bundle = BundleType.Single, SubRadius = 0.015, VoltageRms = vRms, VoltageAngle =    0, CurrentRms = 400, CurrentAngle =    0 },
            new() { Id = "B", X =  0, Y = 12, Bundle = BundleType.Single, SubRadius = 0.015, VoltageRms = vRms, VoltageAngle = -120, CurrentRms = 400, CurrentAngle = -120 },
            new() { Id = "C", X =  4, Y = 12, Bundle = BundleType.Single, SubRadius = 0.015, VoltageRms = vRms, VoltageAngle =  120, CurrentRms = 400, CurrentAngle =  120 },
        ];
        _fieldResults       = null;
        _exposureData       = null;
        _fieldProfileData   = null;
        _edepePlotData      = null;
        _medepmHPlotData    = null;
        _errorMessage       = null;
        _fieldResultView    = ResultView.Charts;
        _exposureResultView = ResultView.Charts;
    }

    private void AddConductor()
        => _conductors.Add(new ConductorModel { Id = $"C{_conductors.Count + 1}" });
    
    private void CalculateField()
    {
        _errorMessage     = null;
        _fieldResults     = null;
        _exposureData     = null;
        _fieldProfileData = null;
        _edepePlotData    = null;
        _medepmHPlotData  = null;
        _fieldResultView  = ResultView.Charts;

        try
        {
            var conductors = BuildConductors();
            var points     = BuildPoints();
            _fieldResults  = FieldCalculator.CalculateField(conductors, points);

            if (_mode == ObsMode.Profile && _fieldResults is not null)
            {
                _fieldProfileData = _fieldResults
                    .Select(r => new FieldProfilePlotPoint(
                        r.Point.X,
                        r.E, r.Ea, r.Eb, r.EFromAxes,
                        r.B * 1e6, r.BFromAxes * 1e6,
                        r.H, r.Ha, r.Hb, r.HFromAxes))
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    /// <summary>
    /// Delegates to the backend CalculateExposure engine.
    /// For constant electrical conditions a single OperatingState with duration T
    /// is created from the current conductor data. The backend then computes:
    ///   EDEPE   = E^p · T
    ///   EdepmH  = H^p · T
    ///   EAverage, HAverage, EMax, EMin, HMax, HMin
    ///   EEquivalent = (EDEPE / T)^(1/p)  = E  (constant field)
    ///   HEquivalent = (EdepmH / T)^(1/p) = H  (constant field)
    /// </summary>
    private void CalculateExposure()
    {
        _errorMessage       = null;
        _exposureData       = null;
        _edepePlotData      = null;
        _medepmHPlotData    = null;
        _exposureResultView = ResultView.Charts;

        if (_fieldResults is null)
        {
            _errorMessage = "Calculate the field first before computing exposure.";
            return;
        }

        try
        {
            var conductors = BuildConductors();
            var points     = BuildPoints();

            // Single operating state = current conductor data for the full exposure duration T
            double t = _exposureTimeHours * 3600.0;
            var state = new OperatingState
            {
                DurationSeconds = t,
                Voltages = conductors.Select(c => c.Voltage).ToList(),
                Currents = conductors.Select(c => c.Current).ToList()
            };

            _exposureData = FieldCalculator.CalculateExposure(conductors, points, [state], _exponentP);

            if (_mode == ObsMode.Profile)
            {
                _edepePlotData   = _exposureData.Select(r => new PlotPoint(r.Point.X, r.Edepe)).ToList();
                _medepmHPlotData = _exposureData.Select(r => new PlotPoint(r.Point.X, r.EdepmH)).ToList();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
    
    private List<Conductor> BuildConductors()
        => _conductors.Select(c => new Conductor
        {
            Id                     = c.Id,
            X                      = c.X,
            Y                      = c.Y,
            // Compute equivalent radius from bundle geometry; Single uses SubRadius directly.
            Radius                 = BundleCalculator.CalculateEquivalentRadius(
                                         c.Bundle, c.SubRadius,
                                         c.Bundle == BundleType.Single ? 0 : c.Spacing),
            Voltage                = ElectromagneticFieldCalculator.Phasor(c.VoltageRms, c.VoltageAngle),
            Current                = ElectromagneticFieldCalculator.Phasor(c.CurrentRms, c.CurrentAngle),
            IncludeInElectricField = c.IncludeE,
            IncludeInMagneticField = c.IncludeB
        }).ToList();

    private List<ObservationPoint> BuildPoints()
    {
        if (_mode == ObsMode.SinglePoint)
            return [new(_ptX, _ptY)];

        int steps = Math.Max(_profSteps, 2);
        double dx = (_profXMax - _profXMin) / (steps - 1);
        return Enumerable.Range(0, steps)
            .Select(i => new ObservationPoint(_profXMin + i * dx, _profY))
            .ToList();
    }
    
    /// <summary>Multi-series profile point for all field profile charts.</summary>
    private record FieldProfilePlotPoint(double X,
                                         double E, double Ea, double Eb, double EFromAxes,
                                         double BMicroTesla, double BFromAxesMicroTesla,
                                         double H, double Ha, double Hb, double HFromAxes);

    /// <summary>Single-value plot point used by exposure charts.</summary>
    private record PlotPoint(double X, double Y);

    private List<FieldProfilePlotPoint>? _fieldProfileData;
    private List<PlotPoint>?             _edepePlotData;
    private List<PlotPoint>?             _medepmHPlotData;
    
    private async Task ExportFieldResultsCsv()
    {
        if (_fieldResults is null) return;

        var ic = System.Globalization.CultureInfo.InvariantCulture;
        var sb = new System.Text.StringBuilder();

        sb.AppendLine(string.Join(";",
            "X_m",
            "Y_m",
            "Ex_V_per_m",
            "Ey_V_per_m",
            "E_V_per_m",
            "Ea_V_per_m",
            "Eb_V_per_m",
            "EFromAxes_V_per_m",
            "EDifference_V_per_m",
            "Bx_T",
            "By_T",
            "B_T",
            "Ba_T",
            "Bb_T",
            "BFromAxes_T",
            "BDifference_T",
            "Bx_uT",
            "By_uT",
            "B_uT",
            "Ba_uT",
            "Bb_uT",
            "BFromAxes_uT",
            "BDifference_uT",
            "Hx_A_per_m",
            "Hy_A_per_m",
            "H_A_per_m",
            "Ha_A_per_m",
            "Hb_A_per_m",
            "HFromAxes_A_per_m",
            "HDifference_A_per_m"));

        foreach (var r in _fieldResults)
        {
            sb.AppendLine(string.Join(";",
                r.Point.X.ToString("G6", ic),
                r.Point.Y.ToString("G6", ic),
                r.Ex.Magnitude.ToString("G6", ic),
                r.Ey.Magnitude.ToString("G6", ic),
                r.E.ToString("G6", ic),
                r.Ea.ToString("G6", ic),
                r.Eb.ToString("G6", ic),
                r.EFromAxes.ToString("G6", ic),
                r.EDifference.ToString("G6", ic),
                r.Bx.Magnitude.ToString("G6", ic),
                r.By.Magnitude.ToString("G6", ic),
                r.B.ToString("G6", ic),
                r.Ba.ToString("G6", ic),
                r.Bb.ToString("G6", ic),
                r.BFromAxes.ToString("G6", ic),
                r.BDifference.ToString("G6", ic),
                (r.Bx.Magnitude * 1e6).ToString("G6", ic),
                (r.By.Magnitude * 1e6).ToString("G6", ic),
                (r.B * 1e6).ToString("G6", ic),
                (r.Ba * 1e6).ToString("G6", ic),
                (r.Bb * 1e6).ToString("G6", ic),
                (r.BFromAxes * 1e6).ToString("G6", ic),
                (r.BDifference * 1e6).ToString("G6", ic),
                r.Hx.Magnitude.ToString("G6", ic),
                r.Hy.Magnitude.ToString("G6", ic),
                r.H.ToString("G6", ic),
                r.Ha.ToString("G6", ic),
                r.Hb.ToString("G6", ic),
                r.HFromAxes.ToString("G6", ic),
                r.HDifference.ToString("G6", ic)));
        }

        await JS.InvokeVoidAsync("downloadFile", "field_results.csv", sb.ToString(), "text/csv;charset=utf-8;");
    }

    private async Task ExportExposureResultsCsv()
    {
        if (_exposureData is null) return;

        var ic = System.Globalization.CultureInfo.InvariantCulture;
        var sb = new System.Text.StringBuilder();

        if (_mode == ObsMode.SinglePoint)
        {
            var d = _exposureData[0];
            sb.AppendLine("Quantity;Value;Unit");
            sb.AppendLine($"E average;{d.EAverage.ToString("G6", ic)};V/m");
            sb.AppendLine($"H average;{d.HAverage.ToString("G6", ic)};A/m");
            sb.AppendLine($"EDEPE (E^p*T);{d.Edepe.ToString("G6", ic)};(V/m)^p*s");
            sb.AppendLine($"E equivalent;{d.EEquivalent.ToString("G6", ic)};V/m");
            sb.AppendLine($"E max;{d.EMax.ToString("G6", ic)};V/m");
            sb.AppendLine($"E min;{d.EMin.ToString("G6", ic)};V/m");
            sb.AppendLine($"EDEPM_H (H^p*T);{d.EdepmH.ToString("G6", ic)};(A/m)^p*s");
            sb.AppendLine($"H equivalent;{d.HEquivalent.ToString("G6", ic)};A/m");
            sb.AppendLine($"H max;{d.HMax.ToString("G6", ic)};A/m");
            sb.AppendLine($"H min;{d.HMin.ToString("G6", ic)};A/m");
        }
        else
        {
            sb.AppendLine("x [m];E_avg [V/m];H_avg [A/m];EDEPE [(V/m)^p*s];EDEPM_H [(A/m)^p*s];E_eq [V/m];H_eq [A/m]");
            foreach (var d in _exposureData)
                sb.AppendLine(string.Join(";",
                    d.Point.X.ToString("G6", ic),
                    d.EAverage.ToString("G6", ic),
                    d.HAverage.ToString("G6", ic),
                    d.Edepe.ToString("G6", ic),
                    d.EdepmH.ToString("G6", ic),
                    d.EEquivalent.ToString("G6", ic),
                    d.HEquivalent.ToString("G6", ic)));
        }

        await JS.InvokeVoidAsync("downloadFile", "exposure_results.csv", sb.ToString(), "text/csv;charset=utf-8;");
    }
}
