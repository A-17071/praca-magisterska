@page "/calculator"
@using ModulKalkulacyjny.Domain
@using ModulKalkulacyjny.Helpers
@using ModulKalkulacyjny.Solvers
@rendermode InteractiveServer
@inject ElectromagneticFieldCalculator FieldCalculator
@inject IJSRuntime JS

<PageTitle>EM Field Calculator</PageTitle>

<div class="page-header mb-4">
    <div>
        <h1 class="page-title">Electromagnetic Field Calculator</h1>
        <p class="page-subtitle">Power line EMF analysis — E, B &amp; H field profiles</p>
    </div>
    <div class="status-badge @(_errorMessage is null ? "" : "status-error")">
        <span class="status-dot"></span>
        @(_errorMessage is null ? "Ready" : "Error")
    </div>
</div>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible mb-3">
        <strong>Error:</strong> @_errorMessage
        <button class="btn-close" @onclick="() => _errorMessage = null"></button>
    </div>
}

<div class="row g-3 align-items-start">

    <!-- ════════════════ LEFT — INPUTS + RESULTS ════════════════════ -->
    <div class="col-12 col-xl-8 order-1 calc-main">

        <div class="section-card mb-3">
            <div class="section-header">
                <span class="section-num">1</span>
                <h5 class="mb-0">Conductors</h5>
                <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="LoadDefaultConductors">
                    ↺ Load 3-phase example
                </button>
            </div>
            <div class="section-body p-2">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-2">
                        <thead class="table-light">
                            <tr>
                                <th>Id</th>
                                <th>x [m]</th>
                                <th>y [m]</th>
                                <th>Bundle</th>
                                <th>r<sub>s</sub> [m]</th>
                                <th>s [m]</th>
                                <th title="Computed equivalent radius (read-only)">r<sub>eq</sub> [m]</th>
                                <th>U [V]</th>
                                <th>φU [°]</th>
                                <th>I [A]</th>
                                <th>φI [°]</th>
                                <th title="Include in electric field">E?</th>
                                <th title="Include in magnetic field">B?</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < _conductors.Count; i++)
                            {
                                var idx = i;
                                var c   = _conductors[idx];
                                var col = GetConductorColor(idx);
                                <tr>
                                    <td>
                                        <span class="cond-badge" style="background:@col">@c.Id</span>
                                    </td>
                                    <td><input class="form-control form-control-sm" style="width:70px" @bind="c.X" /></td>
                                    <td><input class="form-control form-control-sm" style="width:70px" @bind="c.Y" /></td>
                                    <td>
                                        <select class="form-select form-select-sm" style="width:120px" @bind="c.Bundle">
                                            <option value="@BundleType.Single">Single</option>
                                            <option value="@BundleType.Twin">Twin</option>
                                            <option value="@BundleType.TripleTriangle">Triple (△)</option>
                                            <option value="@BundleType.QuadSquare">Quad (□)</option>
                                        </select>
                                    </td>
                                    <td><input class="form-control form-control-sm" style="width:70px" @bind="c.SubRadius" /></td>
                                    <td>
                                        <input class="form-control form-control-sm" style="width:70px"
                                               @bind="c.Spacing"
                                               disabled="@(c.Bundle == BundleType.Single)" />
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm bg-light text-muted" style="width:80px"
                                               value="@c.EquivalentRadius.ToString("G4")"
                                               readonly="readonly" />
                                    </td>
                                    <td><input class="form-control form-control-sm" style="width:95px" @bind="c.VoltageRms" /></td>
                                    <td><input class="form-control form-control-sm" style="width:70px" @bind="c.VoltageAngle" /></td>
                                    <td><input class="form-control form-control-sm" style="width:95px" @bind="c.CurrentRms" /></td>
                                    <td><input class="form-control form-control-sm" style="width:70px" @bind="c.CurrentAngle" /></td>
                                    <td class="text-center"><input type="checkbox" class="form-check-input" @bind="c.IncludeE" /></td>
                                    <td class="text-center"><input type="checkbox" class="form-check-input" @bind="c.IncludeB" /></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => _conductors.Remove(c)">✕</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <button class="btn btn-sm btn-outline-primary" @onclick="AddConductor">+ Add conductor</button>
            </div>
        </div>

        <div class="section-card mb-3">
            <div class="section-header">
                <span class="section-num">2</span>
                <h5 class="mb-0">Observation</h5>
            </div>
            <div class="section-body">
                <div class="mb-3">
                    <div class="mode-btn-group">
                        <button class="mode-btn @(_mode == ObsMode.SinglePoint ? "active" : "")"
                                @onclick="() => _mode = ObsMode.SinglePoint">Single Point</button>
                        <button class="mode-btn @(_mode == ObsMode.Profile ? "active" : "")"
                                @onclick="() => _mode = ObsMode.Profile">Horizontal Profile</button>
                    </div>
                </div>

                @if (_mode == ObsMode.SinglePoint)
                {
                    <div class="row g-3">
                        <div class="col-auto">
                            <label class="form-label small text-muted text-uppercase fw-semibold">X [m]</label>
                            <input class="form-control form-control-sm" style="width:100px" @bind="_ptX" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label small text-muted text-uppercase fw-semibold">Y [m]</label>
                            <input class="form-control form-control-sm" style="width:100px" @bind="_ptY" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        <div class="col-auto">
                            <label class="form-label small text-muted text-uppercase fw-semibold">Height Y</label>
                            <input class="form-control form-control-sm" style="width:90px" @bind="_profY" />
                            <div class="form-text">Observation height</div>
                        </div>
                        <div class="col-auto">
                            <label class="form-label small text-muted text-uppercase fw-semibold">X Min</label>
                            <input class="form-control form-control-sm" style="width:90px" @bind="_profXMin" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label small text-muted text-uppercase fw-semibold">X Max</label>
                            <input class="form-control form-control-sm" style="width:90px" @bind="_profXMax" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label small text-muted text-uppercase fw-semibold">Steps</label>
                            <input class="form-control form-control-sm" style="width:80px" @bind="_profSteps" />
                            <div class="form-text">Number of points</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="section-card mb-3">
            <div class="section-header">
                <span class="section-num">3</span>
                <h5 class="mb-0">Exposure Settings</h5>
            </div>
            <div class="section-body">
                <div class="row g-3 align-items-start mb-3">
                    <div class="col-auto">
                        <label class="form-label small text-muted text-uppercase fw-semibold">Exposure Time T</label>
                        <div class="input-group input-group-sm" style="width:160px">
                            <input class="form-control" @bind="_exposureTimeHours" />
                            <span class="input-group-text">h</span>
                        </div>
                        <div class="form-text">T = @((int)(_exposureTimeHours * 3600)) s</div>
                    </div>
                    <div class="col-auto">
                        <label class="form-label small text-muted text-uppercase fw-semibold">Exponent P</label>
                        <input class="form-control form-control-sm" style="width:100px" @bind="_exponentP" />
                        <div class="form-text">p=2 → time-averaged field</div>
                    </div>
                </div>
                <div class="info-box">
                    ⚠ <strong>Constant-field simplification:</strong>
                    MEDEPE = E<sup>p</sup>·T &nbsp;|&nbsp; MEDEPH = H·T &nbsp;|&nbsp;
                    E<sub>eq</sub> = (MEDEPE/T)<sup>1/p</sup> &nbsp;|&nbsp;
                    H<sub>eq</sub> = (MEDEPH/T)<sup>1/p</sup>.
                    Recommended: p=2 (energetic interpretation). p=1 gives the time-averaged field.
                </div>
            </div>
        </div>

        <div class="d-grid d-sm-flex gap-2 mb-4">
            <button class="btn btn-primary btn-action" @onclick="CalculateField">
                ⚡ Calculate Field
            </button>
            <button class="btn btn-outline-secondary btn-action" @onclick="CalculateExposure"
                    disabled="@(_fieldResults is null)">
                Calculate Exposure
            </button>
        </div>

    </div><!-- /calc-main -->

    <div class="col-12 order-3 pt-3">

        @if (_fieldResults is not null)
        {
            <div class="section-card mb-3">
                <div class="section-header">
                    <h5 class="mb-0">
                        Field Results
                        @if (_mode == ObsMode.Profile)
                        {
                            <span class="text-muted fw-normal fs-6"> — @_fieldResults.Count points</span>
                        }
                    </h5>
                    <div class="ms-auto d-flex gap-2 align-items-center">
                        @if (_mode == ObsMode.Profile)
                        {
                            <div class="view-toggle">
                                <button class="toggle-btn @(_fieldResultView == ResultView.Charts ? "active" : "")"
                                        @onclick="() => _fieldResultView = ResultView.Charts">
                                    📊 Charts
                                </button>
                                <button class="toggle-btn @(_fieldResultView == ResultView.Table ? "active" : "")"
                                        @onclick="() => _fieldResultView = ResultView.Table">
                                    ⊞ Table
                                </button>
                            </div>
                        }
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ExportFieldResultsCsv" title="Export results to CSV">
                            ⬇ Export CSV
                        </button>
                    </div>
                </div>
                <div class="section-body">
                    @if (FieldConsistencyWarningMessage is not null)
                    {
                        <div class="alert alert-warning py-2 mb-3">
                            <strong>Numerical consistency warning:</strong> @FieldConsistencyWarningMessage
                        </div>
                    }

                    @if (_mode == ObsMode.SinglePoint)
                    {
                        var r = _fieldResults[0];
                        <table class="table table-sm table-bordered" style="max-width:500px">
                            <tbody>
                                <tr><th colspan="2" class="table-light">Electric field at (@r.Point.X.ToString("F2") m, @r.Point.Y.ToString("F2") m)</th></tr>
                                <tr><td>Ex [V/m]</td><td>@r.Ex.Magnitude.ToString("G4")</td></tr>
                                <tr><td>Ey [V/m]</td><td>@r.Ey.Magnitude.ToString("G4")</td></tr>
                                <tr><td><strong>E [V/m]</strong></td><td><strong>@r.E.ToString("G4")</strong></td></tr>
                                <tr><td>Ea [V/m]</td><td>@r.Ea.ToString("G4")</td></tr>
                                <tr><td>Eb [V/m]</td><td>@r.Eb.ToString("G4")</td></tr>
                                <tr><td>E from axes [V/m]</td><td>@r.EFromAxes.ToString("G4")</td></tr>
                                <tr><td>|E - E from axes| [V/m]</td><td>@r.EDifference.ToString("G4")</td></tr>
                                <tr><th colspan="2" class="table-light">Magnetic flux density</th></tr>
                                <tr><td>Bx [µT]</td><td>@((r.Bx.Magnitude * 1e6).ToString("G4"))</td></tr>
                                <tr><td>By [µT]</td><td>@((r.By.Magnitude * 1e6).ToString("G4"))</td></tr>
                                <tr><td><strong>B [µT]</strong></td><td><strong>@((r.B * 1e6).ToString("G4"))</strong></td></tr>
                                <tr><td>Ba [µT]</td><td>@((r.Ba * 1e6).ToString("G4"))</td></tr>
                                <tr><td>Bb [µT]</td><td>@((r.Bb * 1e6).ToString("G4"))</td></tr>
                                <tr><td>B from axes [µT]</td><td>@((r.BFromAxes * 1e6).ToString("G4"))</td></tr>
                                <tr><td>|B - B from axes| [µT]</td><td>@((r.BDifference * 1e6).ToString("G4"))</td></tr>
                                <tr><th colspan="2" class="table-light">Magnetic field strength</th></tr>
                                <tr><td>Hx [A/m]</td><td>@r.Hx.Magnitude.ToString("G4")</td></tr>
                                <tr><td>Hy [A/m]</td><td>@r.Hy.Magnitude.ToString("G4")</td></tr>
                                <tr><td><strong>H [A/m]</strong></td><td><strong>@r.H.ToString("G4")</strong></td></tr>
                                <tr><td>Ha [A/m]</td><td>@r.Ha.ToString("G4")</td></tr>
                                <tr><td>Hb [A/m]</td><td>@r.Hb.ToString("G4")</td></tr>
                                <tr><td>H from axes [A/m]</td><td>@r.HFromAxes.ToString("G4")</td></tr>
                                <tr><td>|H - H from axes| [A/m]</td><td>@r.HDifference.ToString("G4")</td></tr>
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <!-- Peak stat cards -->
                        <div class="row g-2 mb-4">
                            <div class="col-12 col-sm-4">
                                <div class="stat-card" style="border-top-color:#1565C0">
                                    <div class="stat-label">Peak Electric Field</div>
                                    <div class="stat-value" style="color:#1565C0">
                                        @PeakE.ToString("G4") <span class="stat-unit">V/m</span>
                                    </div>
                                    <div class="stat-sub">RMS</div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-4">
                                <div class="stat-card" style="border-top-color:#00838F">
                                    <div class="stat-label">Peak Magnetic Flux</div>
                                    <div class="stat-value" style="color:#00838F">
                                        @PeakB.ToString("G4") <span class="stat-unit">µT</span>
                                    </div>
                                    <div class="stat-sub">RMS</div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-4">
                                <div class="stat-card" style="border-top-color:#E65100">
                                    <div class="stat-label">Peak Mag. Field Strength</div>
                                    <div class="stat-value" style="color:#E65100">
                                        @PeakH.ToString("G4") <span class="stat-unit">A/m</span>
                                    </div>
                                    <div class="stat-sub">RMS</div>
                                </div>
                            </div>
                        </div>

                        @if (_fieldResultView == ResultView.Charts)
                        {
                            <div class="row g-3">
                                <div class="col-12 col-xl-6">
                                    <p class="chart-title" style="color:#1565C0">● Electric Field over Distance</p>
                                    <RadzenChart Style="height:380px" AnimationDuration="700">
                                        <RadzenLineSeries Data="@_fieldProfileData" CategoryProperty="X" ValueProperty="E"
                                                          Title="E [V/m]" Smooth="true" Stroke="#1565C0" StrokeWidth="2">
                                            <RadzenMarkers MarkerType="MarkerType.None" />
                                        </RadzenLineSeries>
                                        <RadzenLineSeries Data="@_fieldProfileData" CategoryProperty="X" ValueProperty="Ea"
                                                          Title="Ea [V/m]" Smooth="true" Stroke="#42A5F5" StrokeWidth="1.5" LineType="LineType.Dashed">
                                            <RadzenMarkers MarkerType="MarkerType.None" />
                                        </RadzenLineSeries>
                                        <RadzenLineSeries Data="@_fieldProfileData" CategoryProperty="X" ValueProperty="Eb"
                                                          Title="Eb [V/m]" Smooth="true" Stroke="#90CAF9" StrokeWidth="1.5" LineType="LineType.Dashed">
                                            <RadzenMarkers MarkerType="MarkerType.None" />
                                        </RadzenLineSeries>
                                        <RadzenLineSeries Data="@_fieldProfileData" CategoryProperty="X" ValueProperty="EFromAxes"
                                                          Title="E from axes [V/m]" Smooth="true" Stroke="#0D47A1" StrokeWidth="1.5" LineType="LineType.Dotted">
                                            <RadzenMarkers MarkerType="MarkerType.None" />
                                        </RadzenLineSeries>
                                        <RadzenCategoryAxis FormatString="{0:F0}">
                                            <RadzenGridLines Visible="true" Stroke="#e8ecf0" StrokeWidth="1" />
                                            <RadzenAxisTitle Text="Distance from centre line [m]" />
                                        </RadzenCategoryAxis>
                                        <RadzenValueAxis Min="0" Max="@EChartMax" FormatString="{0:G4}">
                                            <RadzenAxisTitle Text="E [V/m]" />
                                            <RadzenGridLines Visible="true" Stroke="#d0d9e0" StrokeWidth="1" />
                                        </RadzenValueAxis>
                                    </RadzenChart>
                                </div>
                                <div class="col-12 col-xl-6">
                                    <p class="chart-title" style="color:#00838F">● Magnetic Field Strength over Distance</p>
                                    <RadzenChart Style="height:380px" AnimationDuration="700">
                                        <RadzenLineSeries Data="@_fieldProfileData" CategoryProperty="X" ValueProperty="H"
                                                          Title="H [A/m]" Smooth="true" Stroke="#00838F" StrokeWidth="2">
                                            <RadzenMarkers MarkerType="MarkerType.None" />
                                        </RadzenLineSeries>
                                        <RadzenLineSeries Data="@_fieldProfileData" CategoryProperty="X" ValueProperty="Ha"
                                                          Title="Ha [A/m]" Smooth="true" Stroke="#26C6DA" StrokeWidth="1.5" LineType="LineType.Dashed">
                                            <RadzenMarkers MarkerType="MarkerType.None" />
                                        </RadzenLineSeries>
                                        <RadzenLineSeries Data="@_fieldProfileData" CategoryProperty="X" ValueProperty="Hb"
                                                          Title="Hb [A/m]" Smooth="true" Stroke="#80DEEA" StrokeWidth="1.5" LineType="LineType.Dashed">
                                            <RadzenMarkers MarkerType="MarkerType.None" />
                                        </RadzenLineSeries>
                                        <RadzenLineSeries Data="@_fieldProfileData" CategoryProperty="X" ValueProperty="HFromAxes"
                                                          Title="H from axes [A/m]" Smooth="true" Stroke="#004D40" StrokeWidth="1.5" LineType="LineType.Dotted">
                                            <RadzenMarkers MarkerType="MarkerType.None" />
                                        </RadzenLineSeries>
                                        <RadzenCategoryAxis FormatString="{0:F0}">
                                            <RadzenGridLines Visible="true" Stroke="#e8ecf0" StrokeWidth="1" />
                                            <RadzenAxisTitle Text="Distance from centre line [m]" />
                                        </RadzenCategoryAxis>
                                        <RadzenValueAxis Min="0" Max="@HChartMax" FormatString="{0:G4}">
                                            <RadzenAxisTitle Text="H [A/m]" />
                                            <RadzenGridLines Visible="true" Stroke="#d0d9e0" StrokeWidth="1" />
                                        </RadzenValueAxis>
                                    </RadzenChart>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>x [m]</th>
                                            <th>Ex [V/m]</th>
                                            <th>Ey [V/m]</th>
                                            <th>E [V/m]</th>
                                            <th>Ea [V/m]</th>
                                            <th>Eb [V/m]</th>
                                            <th>E from axes [V/m]</th>
                                            <th>|ΔE| [V/m]</th>
                                            <th>Bx [µT]</th>
                                            <th>By [µT]</th>
                                            <th>B [µT]</th>
                                            <th>Ba [µT]</th>
                                            <th>Bb [µT]</th>
                                            <th>B from axes [µT]</th>
                                            <th>|ΔB| [µT]</th>
                                            <th>Hx [A/m]</th>
                                            <th>Hy [A/m]</th>
                                            <th>H [A/m]</th>
                                            <th>Ha [A/m]</th>
                                            <th>Hb [A/m]</th>
                                            <th>H from axes [A/m]</th>
                                            <th>|ΔH| [A/m]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _fieldResults)
                                        {
                                            <tr>
                                                <td>@r.Point.X.ToString("F1")</td>
                                                <td>@r.Ex.Magnitude.ToString("G4")</td>
                                                <td>@r.Ey.Magnitude.ToString("G4")</td>
                                                <td>@r.E.ToString("G4")</td>
                                                <td>@r.Ea.ToString("G4")</td>
                                                <td>@r.Eb.ToString("G4")</td>
                                                <td>@r.EFromAxes.ToString("G4")</td>
                                                <td>@r.EDifference.ToString("G4")</td>
                                                <td>@((r.Bx.Magnitude * 1e6).ToString("G4"))</td>
                                                <td>@((r.By.Magnitude * 1e6).ToString("G4"))</td>
                                                <td>@((r.B * 1e6).ToString("G4"))</td>
                                                <td>@((r.Ba * 1e6).ToString("G4"))</td>
                                                <td>@((r.Bb * 1e6).ToString("G4"))</td>
                                                <td>@((r.BFromAxes * 1e6).ToString("G4"))</td>
                                                <td>@((r.BDifference * 1e6).ToString("G4"))</td>
                                                <td>@r.Hx.Magnitude.ToString("G4")</td>
                                                <td>@r.Hy.Magnitude.ToString("G4")</td>
                                                <td>@r.H.ToString("G4")</td>
                                                <td>@r.Ha.ToString("G4")</td>
                                                <td>@r.Hb.ToString("G4")</td>
                                                <td>@r.HFromAxes.ToString("G4")</td>
                                                <td>@r.HDifference.ToString("G4")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            </div>
        }

        @if (_exposureData is not null)
        {
            <div class="section-card mb-3">
                <div class="section-header">
                    <h5 class="mb-0">
                        Exposure Results
                        <span class="text-muted fw-normal fs-6"> — T=@_exposureTimeHours h, p=@_exponentP</span>
                    </h5>
                    <div class="ms-auto d-flex gap-2 align-items-center">
                        @if (_mode == ObsMode.Profile)
                        {
                            <div class="view-toggle">
                                <button class="toggle-btn @(_exposureResultView == ResultView.Charts ? "active" : "")"
                                        @onclick="() => _exposureResultView = ResultView.Charts">
                                    📊 Charts
                                </button>
                                <button class="toggle-btn @(_exposureResultView == ResultView.Table ? "active" : "")"
                                        @onclick="() => _exposureResultView = ResultView.Table">
                                    ⊞ Table
                                </button>
                            </div>
                        }
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ExportExposureResultsCsv" title="Export results to CSV">
                            ⬇ Export CSV
                        </button>
                    </div>
                </div>
                <div class="section-body">
                    @if (_mode == ObsMode.SinglePoint && _exposureData.Count == 1)
                    {
                        var d = _exposureData[0];
                        <table class="table table-sm table-bordered" style="max-width:540px">
                            <tbody>
                                <tr><th colspan="2" class="table-light">
                                    Point (@d.Point.X.ToString("F2") m, @d.Point.Y.ToString("F2") m)
                                </th></tr>
                                <tr><td>E [V/m]</td><td>@d.EAverage.ToString("G4")</td></tr>
                                <tr><td>H [A/m]</td><td>@d.HAverage.ToString("G4")</td></tr>
                                <tr><th colspan="2" class="table-light">Electric exposure dose</th></tr>
                                <tr>
                                    <td>EDEPE = E<sup>@_exponentP</sup> · T</td>
                                    <td>@d.Edepe.ToString("G4") <span class="text-muted small">(V/m)<sup>@_exponentP</sup>·s</span></td>
                                </tr>
                                <tr><td>E<sub>eq</sub> = (EDEPE / T)<sup>1/p</sup> [V/m]</td><td>@d.EEquivalent.ToString("G4")</td></tr>
                                <tr><td>E max / E min [V/m]</td><td>@d.EMax.ToString("G4") / @d.EMin.ToString("G4")</td></tr>
                                <tr><th colspan="2" class="table-light">Magnetic exposure dose (H)</th></tr>
                                <tr>
                                    <td>EDEPM<sub>H</sub> = H<sup>@_exponentP</sup> · T</td>
                                    <td>@d.EdepmH.ToString("G4") <span class="text-muted small">(A/m)<sup>@_exponentP</sup>·s</span></td>
                                </tr>
                                <tr><td>H<sub>eq</sub> = (EDEPM<sub>H</sub> / T)<sup>1/p</sup> [A/m]</td><td>@d.HEquivalent.ToString("G4")</td></tr>
                                <tr><td>H max / H min [A/m]</td><td>@d.HMax.ToString("G4") / @d.HMin.ToString("G4")</td></tr>
                                <tr><td class="text-muted small" colspan="2">
                                    For constant fields: E<sub>eq</sub> = E<sub>avg</sub> = E<sub>max</sub> = E<sub>min</sub> (and same for H).
                                </td></tr>
                            </tbody>
                        </table>
                    }
                    else
                    {
                        @if (_exposureResultView == ResultView.Charts)
                        {
                            <div class="row g-3">
                                <div class="col-12 col-xl-6">
                                    <p class="chart-title" style="color:#6a1b9a">
