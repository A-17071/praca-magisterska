                                    </thead>
                                    <tbody>
                                        @foreach (var d in _exposureData)
                                        {
                                            <tr>
                                                <td>@d.Point.X.ToString("F1")</td>
                                                <td>@d.EAverage.ToString("G4")</td>
                                                <td>@d.HAverage.ToString("G4")</td>
                                                <td>@d.Edepe.ToString("G4")</td>
                                                <td>@d.EdepmH.ToString("G4")</td>
                                                <td>@d.EEquivalent.ToString("G4")</td>
