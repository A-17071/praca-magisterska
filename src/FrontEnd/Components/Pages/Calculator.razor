@page "/calculator"
@using ModulKalkulacyjny.Domain
@using ModulKalkulacyjny.Helpers
@using ModulKalkulacyjny.Solvers
@rendermode InteractiveServer
@inject ElectromagneticFieldCalculator FieldCalculator

<PageTitle>EM Field Calculator</PageTitle>

<h2 class="mb-4">Electromagnetic Field Calculator</h2>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible">
        <strong>Error:</strong> @_errorMessage
        <button class="btn-close" @onclick="() => _errorMessage = null"></button>
    </div>
}

<!-- ═══════════════════════ 1. CONDUCTORS ═══════════════════════ -->
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">1. Conductors</h5>
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadDefaultConductors">
            Load 3-phase example
        </button>
    </div>
    <div class="card-body p-2">
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-2">
                <thead class="table-light">
                    <tr>
                        <th>Id</th>
                        <th>x [m]</th>
                        <th>y [m]</th>
                        <th>Bundle</th>
                        <th>r<sub>s</sub> [m]</th>
                        <th>s [m]</th>
                        <th title="Computed equivalent radius, read-only">r<sub>eq</sub> [m]</th>
                        <th>U [V]</th>
                        <th>φU [°]</th>
                        <th>I [A]</th>
                        <th>φI [°]</th>
                        <th title="Include in electric field">E?</th>
                        <th title="Include in magnetic field">B?</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _conductors)
                    {
                        <tr>
                            <td><input class="form-control form-control-sm" style="width:50px" @bind="c.Id" /></td>
                            <td><input class="form-control form-control-sm" style="width:75px" @bind="c.X" /></td>
                            <td><input class="form-control form-control-sm" style="width:75px" @bind="c.Y" /></td>
                            <td>
                                <select class="form-select form-select-sm" style="width:120px" @bind="c.Bundle">
                                    <option value="@BundleType.Single">Single</option>
                                    <option value="@BundleType.Twin">Twin</option>
                                    <option value="@BundleType.TripleTriangle">Triple (△)</option>
                                    <option value="@BundleType.QuadSquare">Quad (□)</option>
                                </select>
                            </td>
                            <td><input class="form-control form-control-sm" style="width:75px" @bind="c.SubRadius" /></td>
                            <td>
                                <input class="form-control form-control-sm" style="width:75px"
                                       @bind="c.Spacing"
                                       disabled="@(c.Bundle == BundleType.Single)" />
                            </td>
                            <td>
                                <input style="width:80px" class="form-control form-control-sm text-muted bg-light"
                                       value="@c.EquivalentRadius.ToString("G4")"
                                       readonly="readonly" />
                            </td>
                            <td><input class="form-control form-control-sm" style="width:95px" @bind="c.VoltageRms" /></td>
                            <td><input class="form-control form-control-sm" style="width:75px" @bind="c.VoltageAngle" /></td>
                            <td><input class="form-control form-control-sm" style="width:95px" @bind="c.CurrentRms" /></td>
                            <td><input class="form-control form-control-sm" style="width:75px" @bind="c.CurrentAngle" /></td>
                            <td class="text-center"><input type="checkbox" @bind="c.IncludeE" /></td>
                            <td class="text-center"><input type="checkbox" @bind="c.IncludeB" /></td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => _conductors.Remove(c)">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button class="btn btn-sm btn-outline-primary" @onclick="AddConductor">+ Add conductor</button>
    </div>
</div>

<!-- ═══════════════════════ 2. OBSERVATION ══════════════════════ -->
<div class="card mb-3">
    <div class="card-header"><h5 class="mb-0">2. Observation</h5></div>
    <div class="card-body">
        <div class="mb-3">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" id="modePoint" name="mode"
                       checked="@(_mode == ObsMode.SinglePoint)"
                       @onchange="() => _mode = ObsMode.SinglePoint" />
                <label class="form-check-label" for="modePoint">Single point</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" id="modeProfile" name="mode"
                       checked="@(_mode == ObsMode.Profile)"
                       @onchange="() => _mode = ObsMode.Profile" />
                <label class="form-check-label" for="modeProfile">Horizontal profile</label>
            </div>
        </div>

        @if (_mode == ObsMode.SinglePoint)
        {
            <div class="row g-2">
                <div class="col-auto">
                    <label class="col-form-label">x [m]</label>
                    <input class="form-control form-control-sm" style="width:100px" @bind="_ptX" />
                </div>
                <div class="col-auto">
                    <label class="col-form-label">y [m]</label>
                    <input class="form-control form-control-sm" style="width:100px" @bind="_ptY" />
                </div>
            </div>
        }
        else
        {
            <div class="row g-2">
                <div class="col-auto">
                    <label class="col-form-label">y [m]</label>
                    <input class="form-control form-control-sm" style="width:90px" @bind="_profY" />
                </div>
                <div class="col-auto">
                    <label class="col-form-label">x min [m]</label>
                    <input class="form-control form-control-sm" style="width:90px" @bind="_profXMin" />
                </div>
                <div class="col-auto">
                    <label class="col-form-label">x max [m]</label>
                    <input class="form-control form-control-sm" style="width:90px" @bind="_profXMax" />
                </div>
                <div class="col-auto">
                    <label class="col-form-label">Steps</label>
                    <input class="form-control form-control-sm" style="width:80px" @bind="_profSteps" />
                </div>
            </div>
        }
    </div>
</div>

<!-- ═══════════════════════ 3. EXPOSURE SETTINGS ════════════════ -->
<div class="card mb-3">
    <div class="card-header"><h5 class="mb-0">3. Exposure Settings</h5></div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-auto">
                <label class="form-label mb-1">Exposure time T [h]</label>
                <input class="form-control form-control-sm" style="width:110px" @bind="_exposureTimeHours" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">Exponent p</label>
                <input class="form-control form-control-sm" style="width:80px" @bind="_exponentP" />
            </div>
            <div class="col-auto text-muted small pb-1">
                T = @((int)(_exposureTimeHours * 3600)) s
            </div>
        </div>
        <div class="mt-2 text-muted small">
            <strong>Constant-field simplification:</strong>
            MEDEPE<sub>i</sub> = E<sub>i</sub><sup>p</sup> · T &nbsp;|&nbsp;
            MEDEPM<sub>H,i</sub> = H<sub>i</sub><sup>p</sup> · T &nbsp;|&nbsp;
            E<sub>eq</sub> = (MEDEPE / T)<sup>1/p</sup> &nbsp;|&nbsp;
            H<sub>eq</sub> = (MEDEPM<sub>H</sub> / T)<sup>1/p</sup>
        </div>
        <div class="mt-1 text-muted small">
            Recommended: p = 2 (energetic interpretation, higher weight to peak values).
            p = 1 gives the time-averaged field.
        </div>
    </div>
</div>

<!-- ═══════════════════════ ACTION BUTTONS ══════════════════════ -->
<div class="d-flex gap-2 mb-4">
    <button class="btn btn-primary" @onclick="CalculateField">Calculate Field</button>
    <button class="btn btn-secondary" @onclick="CalculateExposure" disabled="@(_fieldResults is null)">
        Calculate Exposure
    </button>
</div>

<!-- ═══════════════════════ 4. FIELD RESULTS ════════════════════ -->
@if (_fieldResults is not null)
{
    <div class="card mb-3">
        <div class="card-header"><h5 class="mb-0">Field Results</h5></div>
        <div class="card-body p-2">
            @if (_mode == ObsMode.SinglePoint)
            {
                var r = _fieldResults[0];
                <table class="table table-sm table-bordered" style="max-width:500px">
                    <tbody>
                        <tr><th colspan="2" class="table-light">Electric field at (@r.Point.X:F2 m, @r.Point.Y:F2 m)</th></tr>
                        <tr><td>Ex (complex) [V/m]</td><td>@FormatComplex(r.Ex)</td></tr>
                        <tr><td>Ey (complex) [V/m]</td><td>@FormatComplex(r.Ey)</td></tr>
                        <tr><td><strong>E (RMS) [V/m]</strong></td><td><strong>@r.E.ToString("G4")</strong></td></tr>
                        <tr><th colspan="2" class="table-light">Magnetic flux density</th></tr>
                        <tr><td>Bx (complex) [µT]</td><td>@FormatComplex(r.Bx * 1e6)</td></tr>
                        <tr><td>By (complex) [µT]</td><td>@FormatComplex(r.By * 1e6)</td></tr>
                        <tr><td><strong>B (RMS) [µT]</strong></td><td><strong>@((r.B * 1e6).ToString("G4"))</strong></td></tr>
                        <tr><th colspan="2" class="table-light">Magnetic field strength</th></tr>
                        <tr><td>Hx (complex) [A/m]</td><td>@FormatComplex(r.Hx)</td></tr>
                        <tr><td>Hy (complex) [A/m]</td><td>@FormatComplex(r.Hy)</td></tr>
                        <tr><td><strong>H (RMS) [A/m]</strong></td><td><strong>@r.H.ToString("G4")</strong></td></tr>
                    </tbody>
                </table>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>x [m]</th>
                                <th>E [V/m]</th>
                                <th>B [µT]</th>
                                <th>H [A/m]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _fieldResults)
                            {
                                <tr>
                                    <td>@r.Point.X.ToString("F1")</td>
                                    <td>@r.E.ToString("G4")</td>
                                    <td>@((r.B * 1e6).ToString("G4"))</td>
                                    <td>@r.H.ToString("G4")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <!-- RadzenChart – Electric field and Magnetic field strength side by side -->
                <div class="row mt-3 g-3">
                    <div class="col-12 col-xl-6">
                        <h6 class="text-center fw-bold" style="color:#1a237e">Electric Field over Distance</h6>
                        <RadzenChart Style="height:300px">
                            <RadzenLineSeries Data="@_ePlotData"
                                              CategoryProperty="X"
                                              ValueProperty="Y"
                                              Title="E [V/m]"
                                              Smooth="true"
                                              LineType="LineType.Solid"
                                              Stroke="#1a237e"
                                              StrokeWidth="2">
                                <RadzenMarkers MarkerType="MarkerType.None" />
                            </RadzenLineSeries>
                            <RadzenCategoryAxis FormatString="{0:F0}">
                                <RadzenAxisTitle Text="Distance from centre line [m]" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Min="0" FormatString="{0:G3}">
                                <RadzenAxisTitle Text="E [V/m]" />
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                        </RadzenChart>
                    </div>
                    <div class="col-12 col-xl-6">
                        <h6 class="text-center fw-bold" style="color:#006064">Magnetic Field Strength over Distance</h6>
                        <RadzenChart Style="height:300px">
                            <RadzenLineSeries Data="@_hPlotData"
                                              CategoryProperty="X"
                                              ValueProperty="Y"
                                              Title="H [A/m]"
                                              Smooth="true"
                                              LineType="LineType.Solid"
                                              Stroke="#006064"
                                              StrokeWidth="2">
                                <RadzenMarkers MarkerType="MarkerType.None" />
                            </RadzenLineSeries>
                            <RadzenCategoryAxis FormatString="{0:F0}">
                                <RadzenAxisTitle Text="Distance from centre line [m]" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Min="0" FormatString="{0:G3}">
                                <RadzenAxisTitle Text="H [A/m]" />
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                        </RadzenChart>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- ═══════════════════════ 5. EXPOSURE RESULTS ═════════════════ -->
@if (_exposureData is not null)
{
    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">
                Exposure Results &mdash;
                T = @_exposureTimeHours h (@((int)(_exposureTimeHours * 3600)) s),&nbsp;
                p = @_exponentP
            </h5>
        </div>
        <div class="card-body p-2">

            @if (_mode == ObsMode.SinglePoint && _exposureData.Count == 1)
            {
                var d = _exposureData[0];
                <table class="table table-sm table-bordered" style="max-width:540px">
                    <tbody>
                        <tr><th colspan="2" class="table-light">
                            Point (@d.Point.X.ToString("F2") m, @d.Point.Y.ToString("F2") m)
                        </th></tr>
                        <tr><td>E [V/m]</td><td>@d.EAverage.ToString("G4")</td></tr>
                        <tr><td>H [A/m]</td><td>@d.HAverage.ToString("G4")</td></tr>
                        <tr><th colspan="2" class="table-light">Electric exposure dose</th></tr>
                        <tr>
                            <td>EDEPE = E<sup>@_exponentP</sup> · T</td>
                            <td>@d.Edepe.ToString("G4") <span class="text-muted small">(V/m)<sup>@_exponentP</sup>·s</span></td>
                        </tr>
                        <tr><td>E<sub>eq</sub> = (EDEPE / T)<sup>1/p</sup> [V/m]</td><td>@d.EEquivalent.ToString("G4")</td></tr>
                        <tr><td>E max / E min [V/m]</td><td>@d.EMax.ToString("G4") / @d.EMin.ToString("G4")</td></tr>
                        <tr><th colspan="2" class="table-light">Magnetic exposure dose (H)</th></tr>
                        <tr>
                            <td>EDEPM<sub>H</sub> = H<sup>@_exponentP</sup> · T</td>
                            <td>@d.EdepmH.ToString("G4") <span class="text-muted small">(A/m)<sup>@_exponentP</sup>·s</span></td>
                        </tr>
                        <tr><td>H<sub>eq</sub> = (EDEPM<sub>H</sub> / T)<sup>1/p</sup> [A/m]</td><td>@d.HEquivalent.ToString("G4")</td></tr>
                        <tr><td>H max / H min [A/m]</td><td>@d.HMax.ToString("G4") / @d.HMin.ToString("G4")</td></tr>
                        <tr><td class="text-muted small" colspan="2">
                            For constant fields: E<sub>eq</sub> = E<sub>avg</sub> = E<sub>max</sub> = E<sub>min</sub> (and same for H).
                        </td></tr>
                    </tbody>
                </table>
            }
            else
            {
                <!-- Profile table -->
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>x [m]</th>
                                <th>E<sub>avg</sub> [V/m]</th>
                                <th>H<sub>avg</sub> [A/m]</th>
                                <th>EDEPE<br/><small class="text-muted">E<sup>p</sup>·T</small></th>
                                <th>EDEPM<sub>H</sub><br/><small class="text-muted">H<sup>p</sup>·T</small></th>
                                <th>E<sub>eq</sub> [V/m]</th>
                                <th>H<sub>eq</sub> [A/m]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _exposureData)
                            {
                                <tr>
                                    <td>@d.Point.X.ToString("F1")</td>
                                    <td>@d.EAverage.ToString("G4")</td>
                                    <td>@d.HAverage.ToString("G4")</td>
                                    <td>@d.Edepe.ToString("G4")</td>
                                    <td>@d.EdepmH.ToString("G4")</td>
                                    <td>@d.EEquivalent.ToString("G4")</td>
                                    <td>@d.HEquivalent.ToString("G4")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Exposure dose charts -->
                <div class="row mt-3 g-3">
                    <div class="col-12 col-xl-6">
                        <h6 class="text-center fw-bold" style="color:#6a1b9a">
                            EDEPE over Distance (p=@_exponentP, T=@_exposureTimeHours h)
                        </h6>
                        <RadzenChart Style="height:280px">
                            <RadzenLineSeries Data="@_edepePlotData"
                                              CategoryProperty="X"
                                              ValueProperty="Y"
                                              Title="MEDEPE"
                                              Smooth="true"
                                              LineType="LineType.Solid"
                                              Stroke="#6a1b9a"
                                              StrokeWidth="2">
                                <RadzenMarkers MarkerType="MarkerType.None" />
                            </RadzenLineSeries>
                            <RadzenCategoryAxis FormatString="{0:F0}">
                                <RadzenAxisTitle Text="Distance from centre line [m]" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Min="0" FormatString="{0:G3}">
                                <RadzenAxisTitle Text="(V/m)^p·s" />
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                        </RadzenChart>
                    </div>
                    <div class="col-12 col-xl-6">
                        <h6 class="text-center fw-bold" style="color:#bf360c">
                            EDEPM<sub>H</sub> over Distance (p=@_exponentP, T=@_exposureTimeHours h)
                        </h6>
                        <RadzenChart Style="height:280px">
                            <RadzenLineSeries Data="@_medepmHPlotData"
                                              CategoryProperty="X"
                                              ValueProperty="Y"
                                              Title="MEDEPM_H"
                                              Smooth="true"
                                              LineType="LineType.Solid"
                                              Stroke="#bf360c"
                                              StrokeWidth="2">
                                <RadzenMarkers MarkerType="MarkerType.None" />
                            </RadzenLineSeries>
                            <RadzenCategoryAxis FormatString="{0:F0}">
                                <RadzenAxisTitle Text="Distance from centre line [m]" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis Min="0" FormatString="{0:G3}">
                                <RadzenAxisTitle Text="(A/m)^p·s" />
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                        </RadzenChart>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {

    // ── View models ───────────────────────────────────────────────────────────

    /// <summary>Flat UI representation of one conductor / bundle.</summary>
    private class ConductorModel
    {
        public string     Id           { get; set; } = "?";
        public double     X            { get; set; }
        public double     Y            { get; set; } = 12;

        // Bundle geometry
        public BundleType Bundle       { get; set; } = BundleType.Single;
        public double     SubRadius    { get; set; } = 0.015;  // r_s – sub-conductor radius [m]
        public double     Spacing      { get; set; } = 0.4;    // s   – spacing between adjacent sub-conductors [m]

        // Electrical state
        public double     VoltageRms   { get; set; }
        public double     VoltageAngle { get; set; }
        public double     CurrentRms   { get; set; }
        public double     CurrentAngle { get; set; }

        // Inclusion flags
        public bool       IncludeE     { get; set; } = true;
        public bool       IncludeB     { get; set; } = true;

        /// <summary>Equivalent bundle radius r_eq computed from bundle parameters (read-only display).</summary>
        public double EquivalentRadius =>
            BundleCalculator.CalculateEquivalentRadius(Bundle, SubRadius,
                Bundle == BundleType.Single ? 0 : Spacing);
    }

    // ExposurePointData record removed — we use ExposureResult from the backend directly.

    private enum ObsMode { SinglePoint, Profile }

    // ── State ─────────────────────────────────────────────────────────────────

    private List<ConductorModel> _conductors = new();

    private ObsMode _mode      = ObsMode.Profile;
    private double  _ptX;
    private double  _ptY       = 1;
    private double  _profY     = 1;
    private double  _profXMin  = -50;
    private double  _profXMax  =  50;
    private int     _profSteps = 101;

    // Exposure settings
    private double _exposureTimeHours = 8.0;   // default: 8-hour working day
    private double _exponentP         = 2.0;   // p=2 → energetic interpretation

    private IReadOnlyList<FieldResult>?    _fieldResults;
    private IReadOnlyList<ExposureResult>? _exposureData;   // results from backend CalculateExposure
    private string?                        _errorMessage;

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnInitialized() => LoadDefaultConductors();

    // ── Conductor helpers ─────────────────────────────────────────────────────

    private void LoadDefaultConductors()
    {
        double vRms = 110_000.0 / Math.Sqrt(3); // 110 kV line-to-line → phase voltage
        _conductors =
        [
            new() { Id = "A", X = -4, Y = 12, Bundle = BundleType.Single, SubRadius = 0.015, VoltageRms = vRms, VoltageAngle =    0, CurrentRms = 400, CurrentAngle =    0 },
            new() { Id = "B", X =  0, Y = 12, Bundle = BundleType.Single, SubRadius = 0.015, VoltageRms = vRms, VoltageAngle = -120, CurrentRms = 400, CurrentAngle = -120 },
            new() { Id = "C", X =  4, Y = 12, Bundle = BundleType.Single, SubRadius = 0.015, VoltageRms = vRms, VoltageAngle =  120, CurrentRms = 400, CurrentAngle =  120 },
        ];
        _fieldResults    = null;
        _exposureData    = null;
        _ePlotData       = null;
        _hPlotData       = null;
        _edepePlotData   = null;
        _medepmHPlotData = null;
        _errorMessage    = null;
    }

    private void AddConductor()
        => _conductors.Add(new ConductorModel { Id = $"C{_conductors.Count + 1}" });

    // ── Calculation ───────────────────────────────────────────────────────────

    private void CalculateField()
    {
        _errorMessage    = null;
        _fieldResults    = null;
        _exposureData    = null;
        _ePlotData       = null;
        _hPlotData       = null;
        _edepePlotData   = null;
        _medepmHPlotData = null;

        try
        {
            var conductors = BuildConductors();
            var points     = BuildPoints();
            _fieldResults  = FieldCalculator.CalculateField(conductors, points);

            if (_mode == ObsMode.Profile && _fieldResults is not null)
            {
                _ePlotData = _fieldResults.Select(r => new PlotPoint(r.Point.X, r.E)).ToList();
                _hPlotData = _fieldResults.Select(r => new PlotPoint(r.Point.X, r.H)).ToList();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    /// <summary>
    /// Delegates to the backend CalculateExposure engine.
    /// For constant electrical conditions a single OperatingState with duration T
    /// is created from the current conductor data. The backend then computes:
    ///   EDEPE   = E^p · T
    ///   EdepmH  = H^p · T
    ///   EAverage, HAverage, EMax, EMin, HMax, HMin
    ///   EEquivalent = (EDEPE / T)^(1/p)  = E  (constant field)
    ///   HEquivalent = (EdepmH / T)^(1/p) = H  (constant field)
    /// </summary>
    private void CalculateExposure()
    {
        _errorMessage    = null;
        _exposureData    = null;
        _edepePlotData   = null;
        _medepmHPlotData = null;

        if (_fieldResults is null)
        {
            _errorMessage = "Calculate the field first before computing exposure.";
            return;
        }

        try
        {
            var conductors = BuildConductors();
            var points     = BuildPoints();

            // Single operating state = current conductor data for the full exposure duration T
            double t = _exposureTimeHours * 3600.0;
            var state = new OperatingState
            {
                DurationSeconds = t,
                Voltages = conductors.Select(c => c.Voltage).ToList(),
                Currents = conductors.Select(c => c.Current).ToList()
            };

            _exposureData = FieldCalculator.CalculateExposure(conductors, points, [state], _exponentP);

            if (_mode == ObsMode.Profile)
            {
                _edepePlotData   = _exposureData.Select(r => new PlotPoint(r.Point.X, r.Edepe)).ToList();
                _medepmHPlotData = _exposureData.Select(r => new PlotPoint(r.Point.X, r.EdepmH)).ToList();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    // ── Build domain objects from view models ─────────────────────────────────

    private List<Conductor> BuildConductors()
        => _conductors.Select(c => new Conductor
        {
            Id                     = c.Id,
            X                      = c.X,
            Y                      = c.Y,
            // Compute equivalent radius from bundle geometry; Single uses SubRadius directly.
            Radius                 = BundleCalculator.CalculateEquivalentRadius(
                                         c.Bundle, c.SubRadius,
                                         c.Bundle == BundleType.Single ? 0 : c.Spacing),
            Voltage                = ElectromagneticFieldCalculator.Phasor(c.VoltageRms, c.VoltageAngle),
            Current                = ElectromagneticFieldCalculator.Phasor(c.CurrentRms, c.CurrentAngle),
            IncludeInElectricField = c.IncludeE,
            IncludeInMagneticField = c.IncludeB
        }).ToList();

    private List<ObservationPoint> BuildPoints()
    {
        if (_mode == ObsMode.SinglePoint)
            return [new(_ptX, _ptY)];

        int steps = Math.Max(_profSteps, 2);
        double dx = (_profXMax - _profXMin) / (steps - 1);
        return Enumerable.Range(0, steps)
            .Select(i => new ObservationPoint(_profXMin + i * dx, _profY))
            .ToList();
    }

    // ── Formatting helpers ────────────────────────────────────────────────────

    private static string FormatComplex(Complex c)
        => $"{c.Real:G4} + j{c.Imaginary:G4}";

    // ── Chart data ────────────────────────────────────────────────────────────

    /// <summary>Flat x/y pair used by RadzenLineSeries (avoids nested-property reflection issues).</summary>
    private record PlotPoint(double X, double Y);

    private List<PlotPoint>? _ePlotData;
    private List<PlotPoint>? _hPlotData;
    private List<PlotPoint>? _edepePlotData;
    private List<PlotPoint>? _medepmHPlotData;
}
